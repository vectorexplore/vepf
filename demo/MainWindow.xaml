<Window x:Class="VepfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VepfDemo"
        mc:Ignorable="d"
        Title="VePF Demo" Height="680" Width="860"
        Background="White" ThemeMode="Light"
        >

    <ScrollViewer>
        <!-- Override ScrollViewer Style -->
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Width="10" Background="Transparent">
                                <Track x:Name="PART_Track"
                                    IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb Background="Blue"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ScrollViewer.Resources>

        <StackPanel Margin="10">
            <!-- Navigate-->
            <TextBlock Text="0. Navigate" FontSize="16" Foreground="Blue" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Controls" Margin="20 0 0 0" Click="ShowControls_Click"/>
                <Button Content="FontViewer" Margin="20 0 0 0" Click="ShowFontViewer_Click"/>
                <Button Content="TextBox" Margin="20 0 0 0" Click="TextBoxDemo_Click"/>
                <Button Content="Color" Margin="20 0 0 0" Tag="Color" Click="OpenDemo_Click"/>
                <Button Content="Image" Margin="20 0 0 0" Tag="Image" Click="OpenDemo_Click"/>
                <Button Content="ScottPlot" Margin="20 0 0 0" Click="ScottPlotDemo_Click" Cursor="Hand"/>
                <Button Content="Close Window" Margin="20 0 0 0" Click="CloseWindow_Click" Cursor="Hand"/>
            </StackPanel>

            <!-- SECTION 1: SIMPLE SHAPES (Geometric Basics) -->
            <TextBlock Text="1. Text" FontSize="18" Foreground="Blue" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <TextBlock Text="Font 16" FontSize="16" Foreground="Red" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Font 14" FontSize="14" Foreground="Green" Margin="20,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Default Font Size" Foreground="Black" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,10">
                <TextBox x:Name="InputTextBox" Grid.Row="1" Height="23" Width="660" MaxLength="700" Text="Run Windows Presentation Foundation (WPF) applications natively on Linux (.NET 10+)" BorderBrush="Gray" BorderThickness="1"/>
            </StackPanel>

            <TextBlock Text="2. Geometric Shapes" FontSize="18" Foreground="Blue" Margin="0,0,0,10"/>

            <WrapPanel Margin="10" ItemHeight="100" VerticalAlignment="Top">
                <Ellipse  Tag="======== 1. Red Ellipse ========"
                    Name="Ellipse_A" Width="90" Height="60" Fill="Red" Stroke="DarkRed"
                        Margin="10" VerticalAlignment="Center"/>

                <Rectangle Tag="======== 2. Green Rectangle ========"
                    Width="60" Height="60" Fill="Green" RadiusX="10" RadiusY="10"
                        Margin="10" VerticalAlignment="Center"/>

                <Ellipse Tag="======== 3. Yellow Circle ========"
                    Width="60" Height="60" Fill="Yellow" Stroke="Black" StrokeThickness="2"
                        Margin="10" VerticalAlignment="Center" />

                <Viewbox Tag="======== 4. Triangle ========"
                    Width="80" Height="60" Margin="10" VerticalAlignment="Center">
                    <Polygon Points="0,60 40,0 80,60" Fill="Orange" Stroke="Brown" StrokeThickness="2"/>
                </Viewbox>

                <Viewbox Tag="======== 5. Star Fixed the points to be positive so it centers correctly ========"
                    Width="60" Height="60" Margin="10" VerticalAlignment="Center" >
                    <Polygon Fill="Gold" Stroke="Red" StrokeThickness="1"
                            Points="50,0 63,35 100,35 70,57 82,92 50,70 18,92 30,57 0,35 37,35"/>
                </Viewbox>

                <Path Tag="======== 6. Heart ========"
                    Data="M 50,30 A 20,20 0 0,1 90,30 Q 90,60 50,90 Q 10,60 10,30 A 20,20 0 0,1 50,30 Z"                    
                    Fill="Pink" Stroke="DeepPink" StrokeThickness="2"
                    Width="60" Height="60" Stretch="Uniform" Margin="10" VerticalAlignment="Center"/>

                <Path Tag="======== 7. Checkmark ========"
                    Data="M 1,5 L 4,8 L 9,1" Stroke="Green" StrokeThickness="3"
                    Width="40" Height="40" Stretch="Uniform" Margin="10" VerticalAlignment="Center"/>

                <Rectangle Tag="======== 8. Advanced Gradient and Shadow (Glass Effect) ========"
                    Width="80" Height="80" RadiusX="10" RadiusY="10" Margin="10" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3">
                            <GradientStop Color="SkyBlue" Offset="0.0" />
                            <GradientStop Color="SteelBlue" Offset="1.0" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.5"/>
                    </Rectangle.Effect>
                </Rectangle>

                <Path Tag="======== 9. Combined Geometry (Moon Shape - Subtraction) ========"
                    Fill="LightYellow" Stroke="Goldenrod" StrokeThickness="1" Margin="10" VerticalAlignment="Center">
                    <Path.Data>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="40,40" RadiusX="30" RadiusY="30" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="55,40" RadiusX="30" RadiusY="30" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Path.Data>
                </Path>

                <Rectangle Tag="10. Opacity Mask (Fading Shape)"
                    Width="80" Height="60" Fill="Purple" Margin="10" VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Black" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>

                <Grid Tag="11. Glossy Glass Button Effect (Layered Paths)"
                    Width="70" Height="70" Margin="10" VerticalAlignment="Center">
                    <Ellipse Fill="RoyalBlue" Stroke="Navy" StrokeThickness="2"/>
                    <Ellipse VerticalAlignment="Top" Height="30" Margin="10,2,10,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#A0FFFFFF" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <Grid Tag="12. Image-Filled Shape (ImageBrush + Stroke)"
                    Width="170" Height="70" Margin="10" VerticalAlignment="Center">
                    <Ellipse Fill="White">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse Stroke="#E0E0E0" StrokeThickness="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="Resources/Images/vepf-logo-500w.png" 
                                        Stretch="Uniform" 
                                        TileMode="None"
                                        ViewportUnits="RelativeToBoundingBox"
                                        Viewport="0.1,0.1,0.8,0.8"/> 
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>


                <Rectangle Tag="13. Interactive Visual States (Style Triggers)"
                    Width="70" Height="70" RadiusX="5" RadiusY="5" Margin="10" VerticalAlignment="Center">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="LightCoral"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Fill" Value="Crimson"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Red" BlurRadius="15" ShadowDepth="0"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <Rectangle Width="70" Height="50" Margin="10" VerticalAlignment="Center" Stroke="Black"
                    Tag="14. Skewed and Patterned Shape (VisualBrush)">
                    <Rectangle.LayoutTransform>
                        <SkewTransform AngleX="-20"/>
                    </Rectangle.LayoutTransform>
                    <Rectangle.Fill>
                        <VisualBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid>
                                    <Ellipse Fill="Gold" Width="5" Height="5"/>
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>


                <Rectangle Width="70" Height="70" RadiusX="10" RadiusY="10" Margin="10" Stroke="Black" VerticalAlignment="Center"
                    Tag="15. Pattern-Filled Shape (VisualBrush)">
                    <Rectangle.Fill>
                        <VisualBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid>
                                    <Ellipse Fill="RoyalBlue" Width="4" Height="4" Margin="2"/>
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Ellipse Tag="======== 16. The Neon Glow with Style Triggers ========"
                    Width="70" Height="70" Margin="10" VerticalAlignment="Center" Cursor="Hand" ToolTip="Hover to ignite!">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#333333"/>
                            <Setter Property="Stroke" Value="Cyan"/>
                            <Setter Property="StrokeThickness" Value="2"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Fill" Value="Cyan"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Cyan" BlurRadius="20" ShadowDepth="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" CenterX="35" CenterY="35"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>


                <Line Tag="======== 17. Custom Line Caps &amps; Dashes (Technical Drawing Look) ========"
                    X1="0" Y1="0" X2="60" Y2="60" Stroke="DarkSlateBlue" StrokeThickness="8"
                    StrokeDashArray="2,1" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"
                    Margin="20" VerticalAlignment="Center" ToolTip="Custom Caps &amp; Dashes"
                    />

                <StackPanel Tag="======== 18. Visual Reflection (VisualBrush + ScaleTransform) fatal ========"
                    VerticalAlignment="Center" Margin="10">
                    <Rectangle Name="ReflectBase" Width="60" Height="40" Fill="LimeGreen" RadiusX="5" RadiusY="5"/>
                    <Rectangle Width="60" Height="40" Opacity="0.3">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=ReflectBase}"/>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleY="-1" CenterY="20"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="Transparent" Offset="0.3"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </StackPanel>
                <Ellipse Tag="======== 19. Continuous Animation (The Pulsing Orb) ========"
                    Width="60" Height="60" Fill="MediumPurple" Margin="10" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                    From="1.0" To="0.2" Duration="0:0:1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="1.2" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                    <Ellipse.RenderTransform>
                        <ScaleTransform CenterX="30" CenterY="30"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Grid Tag="======== 20. Realistic 3D Sphere (Deep Multi-Stop Gradient) ========"
                    Width="80" Height="80" Margin="10" VerticalAlignment="Center">
                    <Ellipse Fill="Black"/> 
                    <Ellipse Margin="2">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.3,0.3" GradientOrigin="0.3,0.3">
                                <GradientStop Color="White" Offset="0.0" />
                                <GradientStop Color="#FF444444" Offset="0.5" />
                                <GradientStop Color="Black" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Margin="10,40,10,5" Opacity="0.4">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <Grid Tag="======== 21. Perspective Distortion (3D-ish Card) ========"
                    Width="80" Height="80" Margin="10" VerticalAlignment="Center" >
                    <Rectangle Fill="DarkSlateBlue" RadiusX="5" RadiusY="5">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleY="-15"/>
                                <ScaleTransform ScaleX="0.8"/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="10" Direction="315" Opacity="0.4"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <TextBlock Text="VePF" Foreground="White" FontWeight="Bold"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <SkewTransform AngleY="-15"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <Rectangle Tag="======== 22. Animated Snake Border (StrokeDashOffset) ========"
                    Width="80" Height="80" RadiusX="10" RadiusY="10"
                        Stroke="DeepSkyBlue" StrokeThickness="4"
                        StrokeDashArray="4 2" Margin="10" VerticalAlignment="Center">
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                    From="0" To="6" Duration="0:0:1"
                                                    RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>

                <Rectangle Tag="======== 23. Color-Cycle Mood Shape (ColorAnimation) ========"
                    Width="80" Height="80" RadiusX="40" Margin="10" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <SolidColorBrush x:Name="AnimBrush" Color="MediumSpringGreen"/>
                    </Rectangle.Fill>
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetName="AnimBrush"
                                                Storyboard.TargetProperty="Color"
                                                From="MediumSpringGreen" To="MediumVioletRed" Duration="0:0:2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>

            </WrapPanel>

            <TextBlock Text="3. Interactive Standard Controls" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <CheckBox Content="Enable Feature" IsChecked="True" VerticalAlignment="Center" Margin="10"/>
                <ComboBox Width="150" Height="30" SelectedIndex="0" VerticalAlignment="Center" Margin="5">
                    <ComboBoxItem Content="Theme: Red"/>
                    <ComboBoxItem Content="Theme: Blue"/>
                    <ComboBoxItem Content="Theme: Dark"/>
                </ComboBox>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>

