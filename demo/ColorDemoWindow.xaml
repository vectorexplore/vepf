<Window x:Class="VepfDemo.ColorDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VePF Color Demo"
        Height="768"
        Width="1080"
        >
   <Grid>
    <ItemsControl Name="ColorsListBox" Margin="10">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Vertical" Height="720"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="5,2" Width="180">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Rectangle Fill="{Binding ColorBrush}" 
                                   Height="18" Width="40" 
                                   HorizontalAlignment="Left" 
                                   Stroke="Gray" StrokeThickness="0.5"/>

                        <TextBox Grid.Column="1" 
                                Text="{Binding Name, Mode=OneWay}" 
                                IsReadOnly="True" 
                                Background="Transparent" 
                                BorderThickness="0"
                                VerticalAlignment="Center" 
                                FontSize="10" 
                                Margin="8,0,0,0"
                                TextWrapping="NoWrap" />                        
                        <!-- <TextBlock Grid.Column="1" 
                                   Text="{Binding Name}" 
                                   VerticalAlignment="Center" 
                                   FontSize="10" 
                                   Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"/> -->
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Grid>
</Window>
