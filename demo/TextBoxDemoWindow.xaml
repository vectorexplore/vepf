<Window x:Class="VepfDemo.TextBoxDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF TextBox &amp; TextBlock Master Demo"
        Height="850" Width="1200"
        ThemeMode="Light" Background="#F4F7F9"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/> 
            <ColumnDefinition Width="1*"/>   
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,15,0" Padding="0,0,15,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="1. XAML Properties &amp; Styling" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <Border Background="#F8FAFC" CornerRadius="4" Padding="15" Margin="0,0,0,20" 
                        BorderBrush="#3498DB" BorderThickness="5,1,1,1">
                    <StackPanel>
                        <TextBlock Text="TextBlock Inline Formatting &amp; Decorations" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run Text="Default text. "/>
                            <Run Text="Bold text." FontWeight="Bold"/>
                            <Run Text="Italic text. " FontStyle="Italic"/>
                            <Run Text="Colored text." Foreground="DodgerBlue" FontWeight="SemiBold"/>
                        </TextBlock>
                                        
                        <TextBlock FontSize="15" TextWrapping="Wrap">
                            <Run Text="Mixed "/>
                            <Run Text="formatting" FontWeight="Bold" Foreground="#E74C3C"/>
                            <Run Text=" in one TextBlock."/>
                            <LineBreak/> <Run Text="You can also use " Foreground="#555"/>
                            <Run Text="Underline" TextDecorations="Underline" Foreground="#8E44AD" FontWeight="Bold"/>
                            <Run Text=" or " Foreground="#555"/>
                            <Run Text="Strikethrough" TextDecorations="Strikethrough" Foreground="#E67E22" FontWeight="Bold"/>
                            <Run Text=" directly in XAML!" Foreground="#555"/>
                        </TextBlock>
                    </StackPanel>
                </Border>


                <Border Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,20" BorderThickness="2">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#9B59B6" Offset="0.0" />
                            <GradientStop Color="#3498DB" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <StackPanel Margin="5">
                        <TextBlock Text="Text Trimming (Container Width: 300)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="CharacterEllipsis: Delivering native WPF rendering performance on Linux"
                                   TextTrimming="CharacterEllipsis" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8" Foreground="#555"/>
                        
                        <TextBlock Text="WordEllipsis_____: Delivering native WPF rendering performance on Linux"
                                   TextTrimming="WordEllipsis" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8" Foreground="#555"/>
                        
                        <TextBlock Text="None (Default)___: Delivering native WPF rendering performance on Linux"
                                   TextTrimming="None" Width="300" HorizontalAlignment="Left"  Foreground="#555"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E0E5E9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Multi-Line TextBox (With Native SpellCheck)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBox Name="tbMultiLine" TextWrapping="Wrap" Height="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                                 FontSize="15" Padding="8" BorderBrush="#ccc" Background="#FAFAFA"
                                 SpellCheck.IsEnabled="False" Text="[Release Overview &amp; Notes]&#x0a;Welcome to the VePF TextBox and TextBlock showcase. This multi-line editor supports automatic line wrapping, vertical scrolling, and full keyboard navigation across Linux distributions.&#x0a;Thank you for evaluating native WPF rendering on Linux. Notice how intentional spelling errors such as 'happpiness' can be inspected cleanly within standard text controls."
                        />
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="15" Margin="5,5,5,25" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#B0BEC5" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.5"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="Advanced Inlines: Typography &amp; Links" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        
                        <TextBlock FontSize="15" Margin="0,0,0,10" Foreground="#34495E">
                            <Run Text="Math Equation: E = mc" FontWeight="SemiBold"/>
                            <Run Text="2" BaselineAlignment="Superscript" FontSize="11" FontWeight="SemiBold"/>
                            <Run Text="  |  Chemical Formula: H" FontWeight="SemiBold"/>
                            <Run Text="2" BaselineAlignment="Subscript" FontSize="11" FontWeight="SemiBold"/>
                            <Run Text="O" FontWeight="SemiBold"/>
                        </TextBlock>
                                        
                        <TextBlock FontSize="15" TextWrapping="Wrap">
                            <Run Text="Clickable Hyperlink: "/>
                            <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/dotnet/desktop/wpf/" 
                                       RequestNavigate="Hyperlink_RequestNavigate" 
                                       Foreground="#2980B9" TextDecorations="None" FontWeight="SemiBold">
                                Open WPF Documentation
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="2. Interactive C# Capabilities" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

            <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="0,0,0,16">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="13.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>

                <Button Margin="0,0,8,8" Background="#3498DB" Click="BtnRandomize_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,8,0" Fill="White" Stretch="Uniform" Data="M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4H14.5M14.83,13.41L13.42,14.82L16.55,17.95L14.5,20H20V14.5L17.96,16.54L14.83,13.41Z"/>
                        <TextBlock Text="Randomize Style" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Margin="0,0,0,8" Background="#9B59B6" Click="BtnRichText_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,8,0" Fill="White" Stretch="Uniform" Data="M9,4V7H14V19H17V7H22V4H9M3,12H6V19H9V12H12V9H3V12Z"/>
                        <TextBlock Text="Build Rich Text" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Margin="0,0,8,0" Background="#E67E22" Click="BtnManipulateTextBox_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,8,0" Fill="White" Stretch="Uniform" Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z"/>
                        <TextBlock Text="Insert at Caret" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Margin="0" Background="#64748B" Click="BtnReset_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,8,0" Fill="White" Stretch="Uniform" Data="M12,5V1L7,6L12,11V7A6,6 0 0,1 18,13A6,6 0 0,1 12,19A6,6 0 0,1 6,13H4A8,8 0 0,0 12,21A8,8 0 0,0 20,13A8,8 0 0,0 12,5Z"/>
                        <TextBlock Text="Reset Demo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <StackPanel Grid.Row="2">
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E0E5E9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Target TextBox (Manipulate Input)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBox x:Name="InputTextBox" 
                                 Height="120" TextWrapping="Wrap" AcceptsReturn="True" FontStyle="Italic"
                                 Text="Hello! Default text. Place your cursor anywhere in here before clicking 'Manipulate Caret'..."
                                 BorderBrush="#888" BorderThickness="1" Padding="8" FontSize="14"
                                 SelectionBrush="LightBlue" CaretBrush="Red"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E0E5E9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Target TextBlock (Dynamic Properties)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <Border BorderBrush="#CCC" BorderThickness="1" Background="#FAFAFA" Padding="12" MinHeight="120">
                            <TextBlock x:Name="tb1" TextWrapping="Wrap" FontSize="14" Foreground="#333">
                                This is a long text that will wrap to multiple lines. Click the buttons above to change its properties or inject rich text inlines programmatically.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="3" x:Name="MySteppingTextBlock" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
