<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
	  <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- 1. Turn off automatic inclusion of .cs and .xaml files -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <DefineConstants Condition="'$(OS)'=='Windows_NT'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(OS)'!='Windows_NT'">$(DefineConstants);LINUX</DefineConstants>

  </PropertyGroup>

  <PropertyGroup>
  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
</PropertyGroup>

<ItemGroup>
  <!-- <Resource Include="Resources\Fonts\Segoe Fluent Icons.ttf" /> -->
  <Resource Include="Resources\Icons\*.png" />
  <Resource Include="Resources\Images\*.*" />
</ItemGroup>

 <ItemGroup>
   <PackageReference Include="Dirkster.ColorPickerLib" Version="1.6.2" />

   <PackageReference Include="NLog" Version="6.1.1" />
   <Content Include="NLog.config">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
   
   <PackageReference Include="ScottPlot.WPF" Version="5.1.59" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
   <!-- Transitive dependency of ScottPlot.WPF; pinned to suppress NU1701 on net10.0-windows -->
   <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" NoWarn="NU1701" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
 </ItemGroup>

<ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Compile Include="App.xaml.cs"><DependentUpon>App.xaml</DependentUpon></Compile>

    <Page Include="MainWindow.xaml" />
    <Compile Include="MainWindow.xaml.cs"><DependentUpon>MainWindow.xaml</DependentUpon></Compile>

    <Page Include="ColorDemoWindow.xaml" />
    <Compile Include="ColorDemoWindow.xaml.cs"><DependentUpon>ColorDemoWindow.xaml</DependentUpon></Compile>

    <Page Include="ColorPickerDialog.xaml" />
    <Compile Include="ColorPickerDialog.xaml.cs"><DependentUpon>ColorPickerDialog.xaml</DependentUpon></Compile>

    <Page Include="ControlsWindow.xaml" />
    <Compile Include="ControlsWindow.xaml.cs"><DependentUpon>ControlsWindow.xaml</DependentUpon></Compile>

    <Page Include="FontViewerWindow.xaml" />
    <Compile Include="FontViewerWindow.xaml.cs"><DependentUpon>FontViewerWindow.xaml</DependentUpon></Compile>

    <Page Include="ImageDemoWindow.xaml" />
    <Compile Include="ImageDemoWindow.xaml.cs"><DependentUpon>ImageDemoWindow.xaml</DependentUpon></Compile>

    <Page Include="ScottPlotDemoWindow.xaml" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Compile Include="ScottPlotDemoWindow.xaml.cs" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <DependentUpon>ScottPlotDemoWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="TextBoxDemoWindow.xaml" />
    <Compile Include="TextBoxDemoWindow.xaml.cs"><DependentUpon>TextBoxDemoWindow.xaml</DependentUpon></Compile>

    <!-- <Compile Include="Converter/StringRepeatConverter.cs" /> -->

    <!-- <Compile Include="AssemblyInfo.cs" /> -->
  </ItemGroup>

</Project>
