<Window x:Class="VepfDemo.ImageDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VePF Image Demo"
        Height="900"
        Width="980"
        Background="#F4F7F9"
        WindowStartupLocation="CenterScreen"
        >
    <ScrollViewer x:Name="MyScrollViewer">
        <StackPanel Margin="20" x:Name="ScrollContent">

            <UniformGrid Columns="4" Margin="10">
                
                <GroupBox Header="Built-in Resource (PNG)" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/vepf-logo-500w.png" Height="150" Stretch="Uniform" 
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.ToolTip>Loaded via relative pack URI</Image.ToolTip>
                        </Image>
                        <TextBlock Text="vepf-logo-500w.png" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Local Path (Dynamic)" Margin="10">
                    <StackPanel>
                        <Image x:Name="LocalImage" Source="Resources/Images/new-year-wikipedia-2026-w240.png" Height="150" Stretch="Uniform"/>
                        <TextBlock x:Name="PathLabel" Text="file path here" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Transformed &amp; Cached" Margin="10">
                    <StackPanel>
                        <!-- LayoutTransform is better for static rotations than RenderTransform 
                        LayoutTransform vs. RenderTransform: Use LayoutTransform if you want the surrounding UI elements to adjust their position based on the new size of the rotated image. Use RenderTransform if you want it to overlap other elements.
                        -->
                        <Image Source="Resources/Images/vepf-logo-500w.png" Height="150">
                            <Image.LayoutTransform>
                                <RotateTransform Angle="10"/>
                            </Image.LayoutTransform>
                            <!-- CacheMode prevents re-rendering pixels during window resize/animations -->
                            <Image.CacheMode>
                                <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                            </Image.CacheMode>
                        </Image>
                        <TextBlock Text="Rotated 10° with BitmapCache" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <!-- Blur Effect: This is a GPU-accelerated filter. Setting KernelType="Gaussian" provides a smoother, more natural blur than the "Box" type.-->
                <GroupBox Header="Blur Effect" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/vepf-logo-500w.png" Height="150">
                            <Image.Effect>
                                <BlurEffect Radius="10" KernelType="Gaussian"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="Radius=10, Kernel=Gaussian" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Drop Shadow Effect (Quality)" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/vepf-logo-500w.png" Height="150">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="10" 
                                                  ShadowDepth="5" 
                                                  Direction="315" 
                                                  Color="Black" 
                                                  Opacity="0.75" 
                                                  RenderingBias="Quality"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="Radius=10, Depth=5, Bias=Quality" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Opacity &amp; Scaling" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/vepf-logo-500w.png" Height="150" Opacity="0.5"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="50% Opacity" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Clipper (CroppedBitmap)" Margin="10">
                    <StackPanel>
                        <Image Height="150">
                            <Image.Source>
                                <CroppedBitmap Source="Resources/Images/vepf-logo-500w.png" 
                                            SourceRect="68,68,166,166" />
                            </Image.Source>
                        </Image>
                        <TextBlock Text="Cropped" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Flip Horizontal" Margin="10">
                    <StackPanel>
                        <Image Height="150">
                            <Image.Source>
                                <TransformedBitmap Source="Resources/Images/vepf-logo-500w.png">
                                    <TransformedBitmap.Transform>
                                        <!-- ScaleX = -1 flips the image horizontally -->
                                        <ScaleTransform ScaleX="-1" />
                                    </TransformedBitmap.Transform>
                                </TransformedBitmap>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="Flipped (Mirror)" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- <GroupBox Header="Rotate 90° CW" Margin="10">
                    <StackPanel>
                        <Image Height="150">
                            <Image.Source>
                                <TransformedBitmap Source="Resources/Images/vepf-logo-500w.png">
                                    <TransformedBitmap.Transform>
                                        <RotateTransform Angle="90" />
                                    </TransformedBitmap.Transform>
                                </TransformedBitmap>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="Rotated 90°" HorizontalAlignment="Center"/>
                    </StackPanel>
                </GroupBox> -->

                <GroupBox Header="Flip Vertical + Rotate 180" Margin="10">
                    <StackPanel>
                        <Image Height="150" x:Name="FlipRotateDemoImg">
                            <Image.Source>
                                <TransformedBitmap Source="Resources/Images/vepf-logo-500w.png">
                                    <TransformedBitmap.Transform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleY="-1" />
                                            <RotateTransform Angle="180" />
                                        </TransformGroup>
                                    </TransformedBitmap.Transform>
                                </TransformedBitmap>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="Flipped &amp; Rotated" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Built-in Resource (ico)" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/vepf-logo.ico" Height="150" Stretch="Uniform" 
                                RenderOptions.BitmapScalingMode="HighQuality">
                        </Image>
                        <TextBlock Text="vepf-logo.ico" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Built-in Resource (jpg)" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/vepf-logo-500w.jpg" Height="150" Stretch="Uniform" 
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.ToolTip>Loaded via relative pack URI</Image.ToolTip>
                        </Image>
                        <TextBlock Text="vepf-logo-500w.jpg" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Built-in Resource (gif)" Margin="10">
                    <StackPanel>
                        <Image Source="Resources/Images/spinner-demo.gif" Height="150" Stretch="Uniform" 
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.ToolTip>Loaded via relative pack URI</Image.ToolTip>
                        </Image>
                        <TextBlock Text="spinner-demo.gif" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                
            </UniformGrid>

            <UniformGrid Rows="1" Margin="10">
                <Button Content="Save Full"  Click="SaveFullContent_Click" Width="120" Margin="10,0,0,0" Background="#0078d7" Foreground="White"/>
                <Button Content="Save One"   Click="OnOneImgSaveClicked"   Width="120" Margin="10,0,0,0" Background="#0078d7" Foreground="White"/>
                <Button Content="Load Image" Click="LoadCustomImage_Click" Width="120" Margin="10,0,0,0" Background="#0078d7" Foreground="White"/>
            </UniformGrid>

            <TextBlock x:Name="tb1" TextWrapping="Wrap" FontSize="14" Foreground="#333">
                codec info here.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Window>
