<Window x:Class="VepfDemo.ScottPlotDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linux WPF Command Center (SDL3 Shim)"
        Height="900" Width="1440"
        Background="#0B1120"
        WindowStartupLocation="CenterScreen"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="NATIVE LINUX TELEMETRY DASHBOARD" FontSize="32" FontWeight="Black" Foreground="#10B981"/>
                <TextBlock Text="6-Pane SkiaSharp Render Pipeline • 60 FPS Cap • Real-time Data Mutability" FontSize="14" Foreground="#94A3B8" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="15,10" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Poll Rate: " Foreground="#94A3B8" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="{Binding ElementName=RefreshSlider, Path=Value, StringFormat={}{0:0.0}s}" Foreground="#10B981" FontWeight="Bold" Width="40" VerticalAlignment="Center" FontSize="16"/>
                    <Slider x:Name="RefreshSlider" Width="150" Minimum="0.1" Maximum="2.0" Value="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0,0,0" ValueChanged="RefreshSlider_ValueChanged"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#1E293B" CornerRadius="12" Margin="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <ScottPlot:WpfPlot x:Name="PlotTelemetry" />
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Background="#1E293B" CornerRadius="12" Margin="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <ScottPlot:WpfPlot x:Name="PlotHeatmap" />
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="#1E293B" CornerRadius="12" Margin="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <ScottPlot:WpfPlot x:Name="PlotBarChart" />
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" CornerRadius="12" Margin="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <ScottPlot:WpfPlot x:Name="PlotRadar" />
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Background="#1E293B" CornerRadius="12" Margin="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <ScottPlot:WpfPlot x:Name="PlotScatter" />
            </Border>
        </Grid>
    </Grid>
</Window>